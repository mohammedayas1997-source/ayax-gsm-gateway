    xmlns:android="http://schemas.android.com/apk/res/android"

    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewFocused|typeViewTextChanged"

    android:packageNames="com.android.phone,com.google.android.dialer,com.samsung.android.dialer"

    android:accessibilityFeedbackType="feedbackGeneric"

    android:notificationTimeout="50"

    android:canRetrieveWindowContent="true"

